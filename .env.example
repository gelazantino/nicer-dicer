# Match server WebSocket base URL (include protocol, no trailing slash).
# Production (Vercel + Caddy TLS): wss://dice.lockersmoker.com
# Direct VPS (local HTTP only):    ws://31.210.171.38:8787
VITE_WS_URL=wss://dice.lockersmoker.com

# Auth / inventory HTTP API (same host as match server in production).
# Production: https://dice.lockersmoker.com
# Local:      http://127.0.0.1:8787
VITE_API_URL=https://dice.lockersmoker.com

# Server-only (VPS): JWT signing secret — set a long random value in production.
# JWT_SECRET=
# SQLITE_PATH=/var/lib/nicer-dicer/nicer-dicer.sqlite
# CORS_ORIGINS=https://nicer-dicer.vercel.app,http://localhost:5173
